---
import { profile } from '../data/profile';
---
<section class="hero-wrap" id="top" data-hero data-desktop-count="300" data-mobile-count="120">
  <div class="hero-stage">
    <div class="hero-visual" aria-hidden="true">
      <img class="hero-poster" src="/hero-poster.webp" alt="" decoding="async" fetchpriority="high" />
      <canvas class="hero-canvas" data-hero-canvas aria-hidden="true"></canvas>
    </div>
    <div class="hero-gradient" aria-hidden="true"></div>
    <div class="hero-guide hero-guide--left" aria-hidden="true"></div>
    <div class="hero-guide hero-guide--right" aria-hidden="true"></div>

    <div class="hero-chapter hero-chapter--intro is-active" data-chapter="0">
      <div class="hero-chapter-inner">
        <div class="overline"><span class="overline-dot"></span> HELLO, I'M</div>
        <h1><span>SYED MUHAMMAD</span><strong>TAFSEER<span class="accent" aria-hidden="true">.</span></strong><span class="hero-surname">RAZA BUKHARI</span></h1>
        <p class="hero-job">{profile.headline} <span class="slash">/</span> {profile.secondaryHeadline}</p>
        <p class="hero-intro">{profile.intro}</p>
        <a class="hero-work-link" href="#work">EXPLORE SELECTED WORK <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="hero-chapter hero-chapter--statement" data-chapter="1">
      <div class="hero-chapter-inner"><span class="overline">BUILDING WITH PURPOSE</span><h2>I BUILD.<br />I OWN.<br /><em>I SHIP.</em></h2><p>Ideas, complex challenges and working digital products.</p></div>
    </div>
    <div class="hero-chapter hero-chapter--statement" data-chapter="2">
      <div class="hero-chapter-inner"><span class="overline">ENGINEERED TO MATTER</span><h2>BEYOND<br /><em>THE CODE.</em></h2><p>Thoughtful interfaces. Connected systems. Real-world outcomes.</p></div>
    </div>

    <div class="hero-edge-label" aria-hidden="true">CREATIVE ENGINEERING <span>—</span> {new Date().getFullYear()}</div>
    <div class="hero-bottom-row"><span><i class="scroll-line"></i> SCROLL TO EXPLORE</span><span class="hero-progress-label" aria-hidden="true"><span class="hero-progress-track"><i data-hero-progress></i></span> DISCOVER MORE ↘</span></div>
  </div>
</section>
