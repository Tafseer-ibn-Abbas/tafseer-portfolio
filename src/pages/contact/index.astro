const gmailCompose = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(profile.links.email)}&su=${encodeURIComponent('Project Inquiry')}`;
const appCompose = `mailto:${profile.links.email}?subject=Project%20Inquiry`;
---
<BaseLayout
  title={`Contact ${profile.name} — Let's Build Something`}
  description={`Contact ${profile.name}, software engineer and full-stack product builder in Karachi, Pakistan. Email, LinkedIn, GitHub, Upwork, Fiverr, WhatsApp and Instagram.`}
>
  <section class="reach-hero" data-page-interactions aria-labelledby="reach-title">
    <div class="container reach-hero-inner">
      <p class="section-kicker" data-reveal>01 / CONTACT & COLLABORATION</p>
      <h1 id="reach-title" data-reveal>HAVE A<br /><em>PROJECT?</em></h1>
      <div class="reach-hero-meta" data-reveal>
        <p>From a new digital product to an existing system that needs serious engineering, the best place to start is a conversation.</p>
        <div class="reach-coordinate"><span class="reach-online-dot" aria-hidden="true"></span> KARACHI, PAKISTAN</div>
      </div>
    </div>
  </section>

  <section class="container reach-email-section" aria-labelledby="email-title">
    <div class="reach-email-top" data-reveal>
      <span class="section-kicker">02 / DIRECT LINE</span>
      <span class="reach-email-aside">EMAIL OR CONNECT ON YOUR PLATFORM</span>
    </div>
    <h2 id="email-title" data-reveal>LET'S START<br /><em>WITH HELLO.</em></h2>
    <div class="reach-email-card" data-reveal>
      <div class="reach-email-info">
        <span class="reach-small-label">EMAIL ME DIRECTLY</span>
        <a class="reach-email-address" href={gmailCompose} target="_blank" rel="noopener noreferrer" aria-label={`Email ${profile.name} at ${profile.links.email}`}>{profile.links.email}<span aria-hidden="true">↗</span></a>
        <p>Tell me what you're building, what needs solving, or what you'd like to discuss.</p>
        <div class="reach-email-methods">
          <a href={gmailCompose} target="_blank" rel="noopener noreferrer">OPEN GMAIL <span aria-hidden="true">↗</span></a>
          <a href={appCompose}>USE EMAIL APP <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <button class="reach-copy" type="button" data-copy-email data-email={profile.links.email} aria-label="Copy email address to clipboard"><span data-copy-label>COPY EMAIL</span><span aria-hidden="true">⧉</span></button>
    </div>
  </section>

  <section class="reach-social" aria-labelledby="social-title">
    <div class="container">
      <div class="reach-social-title" data-reveal>
        <p class="section-kicker">03 / ELSEWHERE ONLINE</p>
        <h2 id="social-title">CONNECT<br /><em>ONLINE.</em></h2>
      </div>
      <p class="reach-social-note">{profile.identityNote}</p>
      <div class="reach-social-grid">
        {socialLinks.map((item) => (
          <a class:list={["reach-social-card", `reach-social-card--${item.brand}`]} href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`${item.name}: ${item.identity} (opens in a new tab)`} data-social-card>
            <div class="reach-social-top">
              <span class="reach-social-brand" aria-hidden="true"><svg viewBox="0 0 24 24" width="38" height="38" fill="currentColor" focusable="false"><path d={item.iconPath} /></svg></span>
              <span class="reach-social-number">{item.no} / CONNECT</span>
              <span class="reach-social-arrow" aria-hidden="true">↗</span>
            </div>
            <div class="reach-social-bottom">
              <h3>{item.name}</h3>
              <p class="reach-social-identity">{item.identity}</p>
              <p class="reach-social-description">{item.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="container reach-endnote" data-reveal><span class="reach-online-dot" aria-hidden="true"></span><p>Based in Karachi, Pakistan. Available for remote collaborations and software projects.</p><a href="/about/">MORE ABOUT ME <span aria-hidden="true">↗</span></a></section>
</BaseLayout>

<style>
  .reach-social-note { max-width: 760px; margin: -22px 0 40px; color: #cbbcc0; font-size: 14px; line-height: 1.7; }
  :global(.reach-social-card--whatsapp .reach-social-brand) { color: #6fe1a1; }
  :global(.reach-social-card--instagram .reach-social-brand) { color: #f59ac0; }
  :global(.reach-social-card--whatsapp:hover),
  :global(.reach-social-card--whatsapp:focus-visible) { border-color: rgba(76, 200, 137, .62); }
  :global(.reach-social-card--instagram:hover),
  :global(.reach-social-card--instagram:focus-visible) { border-color: rgba(245, 115, 175, .58); }
</style>
